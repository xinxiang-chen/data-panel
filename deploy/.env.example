# Production settings for docker-compose.prod.yml. On the server:
#   cp .env.example .env && chmod 600 .env
# Never commit .env.

# Public hostname of the API; its DNS A record must point at this VM.
DOMAIN=api.example.com

# Generate both with: openssl rand -hex 32
# (hex keeps the password safe to embed in DATABASE_URL without escaping)
POSTGRES_PASSWORD=
# Same value goes into the frontend's API_TOKEN on Vercel.
API_TOKEN=

# Must match the frontend's PROJECT_ID.
PROJECT_ID=demo

# Optional: run a prebuilt image instead of building on the server (CD).
# BACKEND_IMAGE=ghcr.io/<owner>/digital-twin-data-panel-backend:latest

# Optional: other host ports, e.g. to test locally next to other services.
# HTTP_PORT=80
# HTTPS_PORT=443

# Backend configuration. Copy to backend/.env for local development:
#   cp .env.example .env
# In production, set the same variables in the server's environment (or a .env
# that is never committed). Real environment variables override .env.

# development | production. production refuses to start with a weak API_TOKEN.
APP_ENV=development

# SQLAlchemy + asyncpg URL.
#   Local (docker compose, port 5433): the value below.
#   Same compose network on a server:  postgresql+asyncpg://USER:PASS@db:5432/sensor_sim
#   Managed / remote Postgres:         append ?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/sensor_sim

# Path segment of the IoT API: /api/{PROJECT_ID}/devices. Must match the frontend.
PROJECT_ID=demo

# Shared secret the Next.js server sends as "Authorization: Bearer <token>".
# Must match the frontend's API_TOKEN. Production: openssl rand -hex 32
API_TOKEN=dev

# Live simulator worker: tops up readings to "now" while the API runs.
SIM_ENABLED=true
SIM_INTERVAL_S=60
# After downtime, regenerate at most this many days (older history: seed script).
SIM_MAX_CATCH_UP_DAYS=7
